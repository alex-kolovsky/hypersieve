/dts-v1/;

/ {
    #address-cells = <1>;
    #size-cells = <1>;

    hypervisor-config {
        vlen-size = <32>;
        vm0 {
            path = "target/guest-1/guest-1.bin";

            hart-capacity = <2>;
            assigned-harts = <0 1>;

            entry = <0x100000>;
        };

        vm1 {
            path = "target/guest-2/guest-2.bin";

            hart-capacity = <2>;

            entry = <0x100000>;
        };
    };
};
