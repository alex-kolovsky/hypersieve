/dts-v1/;

/ {
    #address-cells = <1>;
    #size-cells = <1>;

    hypervisor-config {
        vm0 {
            path = "target/guest/guest.bin";

            harts-cap = <2>;
            dedicated-harts = <100 2 3>;

            entry = <0x100000>;
        };

        vm1 {
            path = "target/guest-2/guest.bin";

            harts-cap = <3>;

            entry = <0x100000>;
        };
    };
};
